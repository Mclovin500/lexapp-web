# /api pasa por el proxy de Vite hacia Back_Lexapp (ver vite.config.ts)
VITE_API_URL=/api
# Destino del proxy (perfil "https" de launchSettings.json). Usa https: el puerto http (5078)
# responde 307 por UseHttpsRedirection y corta las subidas multipart (registro con cédula).
# Si corres el backend solo con el perfil "http", cámbialo a http://localhost:5078.
VITE_PROXY_API=https://localhost:7276
VITE_USAR_MOCKS=true
# P04: enlaces públicos de la app de clientes (vacíos = botón "Próximamente")
VITE_URL_GOOGLE_PLAY=
VITE_URL_APP_STORE=
